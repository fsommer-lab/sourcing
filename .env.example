# ── PitchBook ──────────────────────────────────────────────────────────────────
# No API key needed — the pipeline uses your Claude Code installation directly.
PITCHBOOK_API_KEY=

# ── Grata ──────────────────────────────────────────────────────────────────────
# Find your API key in Grata → Settings → API Access
GRATA_API_KEY=your_grata_api_key_here

# ── Salesforce ─────────────────────────────────────────────────────────────────
SALESFORCE_USERNAME=you@yourfirm.com
SALESFORCE_PASSWORD=your_salesforce_password
# Get your security token: Salesforce → Settings → My Personal Information → Reset My Security Token
SALESFORCE_SECURITY_TOKEN=your_security_token
# Use "test" for sandbox, "login" for production
SALESFORCE_DOMAIN=login

# ── Slack ──────────────────────────────────────────────────────────────────────
# Outbound digest webhook: api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Slash command bot: api.slack.com/apps → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Optional: port for the slash command server (default 3000)
PORT=3000

# ngrok auth token — ngrok.com dashboard → Your Authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# ngrok static domain — ngrok.com dashboard → Domains → New Domain
NGROK_DOMAIN=your-words-1234.ngrok-free.app
